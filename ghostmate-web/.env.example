# GhostMate frontend environment — template only.
# Copy to .env.local for LOCAL overrides. .env.local is gitignored: never commit it.
#
# Precedence (Vite): variables already present in the build environment — e.g.
# Vercel → Project → Settings → Environment Variables — win over EVERY .env
# file. .env / .env.local only affect local `npm run dev` / `npm run build`.
#
# The MatchRegistry id is intentionally NOT configurable here. It is pinned in
# src/config.ts (REGISTRY_ID + REGISTRY_BECH32, checked against each other at
# startup) as the single source of truth. VITE_REGISTRY_ID is ignored.

# Miden RPC endpoint: testnet | devnet | localhost | <url>   (default: testnet)
# VITE_RPC_URL=testnet

# Prover: local | testnet | devnet | <url>                    (default: testnet)
# VITE_PROVER_URL=testnet

# Wager faucet for Phase 2D.2 challenges (unused in 2D.1)
# VITE_WAGER_FAUCET_ID=0x0000000000000000
